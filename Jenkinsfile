pipeline {
    agent any
    
    stages {
        stage('📥 Получение кода из GitHub') {
            steps {
                checkout scm
                echo "✅ Код получен"
                echo "📌 Ветка: ${env.BRANCH_NAME}"
                echo "📌 Коммит: ${env.GIT_COMMIT}"
            }
        }
        
        stage('🔍 Информация о проекте') {
            steps {
                echo """
                ════════════════════════════════════════════
                📁 ПРОЕКТ: DevOps
                🌿 ВЕТКА: ${env.BRANCH_NAME}
                👤 АВТОР: ${env.GIT_AUTHOR_NAME}
                ════════════════════════════════════════════
                """
            }
        }
        
        stage('🚀 Статус деплоя') {
            when {
                branch 'main'
            }
            steps {
                echo """
                ════════════════════════════════════════════
                🚀 ДЕПЛОЙ НА ПРОДАКШН
                Ветка: main
                Статус: ✅ Готов к деплою
                URL: http://localhost:8080
                ════════════════════════════════════════════
                """
            }
        }
        
        stage('ℹ️ Для других веток') {
            when {
                not { branch 'main' }
            }
            steps {
                echo """
                ════════════════════════════════════════════
                📌 ВЕТКА: ${env.BRANCH_NAME}
                ℹ️  Деплой только для main
                📌 Сделайте merge в main для деплоя
                ════════════════════════════════════════════
                """
            }
        }
    }
    
    post {
        success {
            echo """
            ════════════════════════════════════════════
            ✅ УСПЕШНО!
            Ветка: ${env.BRANCH_NAME}
            ════════════════════════════════════════════
            """
        }
        failure {
            echo """
            ════════════════════════════════════════════
            ❌ ОШИБКА!
            Ветка: ${env.BRANCH_NAME}
            ════════════════════════════════════════════
            """
        }
    }
}
